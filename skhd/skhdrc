alt - h : yabai -m window --focus west || yabai -m display --focus west
alt - n : yabai -m window --focus south || yabai -m display --focus south
alt - e : yabai -m window --focus north || yabai -m display --focus north
alt - i : yabai -m window --focus east || yabai -m display --focus east
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - c : yabai -m space --create
alt - x : yabai -m space --destroy
shift + alt - 1 : yabai -m window --space 1
shift + alt - 2 : yabai -m window --space 2
shift + alt - 3 : yabai -m window --space 3
shift + alt - 4 : yabai -m window --space 4
shift + alt - 5 : yabai -m window --space 5
shift + alt - 6 : yabai -m window --space 6
shift + alt - 7 : yabai -m window --space 7
shift + alt - 8 : yabai -m window --space 8
shift + alt - 9 : yabai -m window --space 9
alt + cmd - 1 : yabai -m window --space 1 & yabai -m space --focus 1
alt + cmd - 2 : yabai -m window --space 2 && yabai -m space --focus 2
alt + cmd - 3 : yabai -m window --space 3 && yabai -m space --focus 3
alt + cmd - 4 : yabai -m window --space 4 && yabai -m space --focus 4
alt + cmd - 5 : yabai -m window --space 5 && yabai -m space --focus 5
alt + cmd - 6 : yabai -m window --space 6 && yabai -m space --focus 6
alt + cmd - 7 : yabai -m window --space 7 && yabai -m space --focus 7
alt + cmd - 8 : yabai -m window --space 8 && yabai -m space --focus 8
alt + cmd - 9 : yabai -m window --space 9 && yabai -m space --focus 9

shift + alt - h : yabai -m window --swap west
shift + alt - n : yabai -m window --swap south
shift + alt - e : yabai -m window --swap north
shift + alt - i : yabai -m window --swap east

ctrl + alt - h : yabai -m window --resize left:-40:0 || yabai -m window --resize right:-40:0
ctrl + alt - n : yabai -m window --resize bottom:0:40 || yabai -m window --resize top:0:40
ctrl + alt - e : yabai -m window --resize bottom:0:-40 || yabai -m window --resize top:0:-40
ctrl + alt - i : yabai -m window --resize right:40:0 || yabai -m window --resize left:40:0

cmd + alt - h : yabai -m window --warp west
cmd + alt - n : yabai -m window --warp south
cmd + alt - e : yabai -m window --warp north
cmd + alt - i : yabai -m window --warp east

alt - return : yabai -m window --toggle float
alt - f : yabai -m window --toggle zoom-fullscreen
alt - p : yabai -m window --toggle zoom-parent
alt + shift - f : "$HOME/.config/yabai/add_current_app_float.py"
ctrl + alt - b : yabai -m space --layout bsp
shift + alt - b : yabai -m space --balance
shift + alt - r : yabai --restart-service
